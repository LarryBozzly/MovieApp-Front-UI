{
  "compilerOptions": {
    "target": "ES2020",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@ui": ["src/ui"],
      "@ui/*": ["src/ui/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@guards": ["src/guards"],
      "@guards/*": ["src/guards/*"],
      "@store": ["src/store"],
      "@store/*": ["src/store/*"],
      "@config": ["src/config"],
      "@config/*": ["src/config/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@pages": ["src/pages"],
      "@pages/*": ["src/pages/*"],
      "@routes": ["src/routes"],
      "@routes/*": ["src/routes/*"],
      "@models": ["src/models"],
      "@models/*": ["src/models/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
